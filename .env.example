# Server SMTP (nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM=you@yourdomain.com
EMAIL_TO=cheragsaxena16@gmail.com

# Optional: SendGrid (not required if using SMTP)
#SENDGRID_API_KEY=

# Client-side EmailJS (public keys)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Optional: allow pnpm to ignore frozen-lockfile in CI (only if needed)
#PNPM_FLAGS=--no-frozen-lockfile
